{% extends 'base.html' %}
{% load static %}
{% load ged_tags %}

{% block title %}Ajouter au réseau familial - DITAS{% endblock %}

{% block content %}
<div class="max-w-4xl mx-auto px-4 py-8">
    <div class="mb-8 flex items-center justify-between">
        <div>
            <h1 class="text-3xl font-bold text-gray-900">
                <i class="fas fa-users text-blue-600 mr-3"></i>Ajouter un membre au réseau
            </h1>
            <p class="text-gray-500 mt-1 italic">
                Création d'un lien avec : <strong class="text-blue-700">{{ beneficiaire_principal.nom|upper }} {{ beneficiaire_principal.prenom }}</strong>
            </p>
        </div>
        <a href="{% url 'beneficiaire:detail_beneficiaire' code_interne=beneficiaire_principal.code_interne %}" 
           class="text-gray-400 hover:text-red-500 transition-colors" title="Annuler et retourner au dossier">
            <i class="fas fa-times text-2xl"></i>
        </a>
    </div>

    <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-6 rounded-r-lg shadow-sm">
        <div class="flex">
            <i class="fas fa-info-circle text-blue-400 mt-1"></i>
            <div class="ml-3">
                <p class="text-sm text-blue-800">
                    Cette action crée une <strong>fiche individuelle</strong> propre à cette personne tout en la liant au dossier de {{ beneficiaire_principal.prenom }}.
                </p>
            </div>
        </div>
    </div>

    <form method="post" class="space-y-8 bg-white shadow-xl border border-gray-100 rounded-2xl p-8">
        {% csrf_token %}

        {{ form.mds.as_hidden }}
        {{ form.adresse.as_hidden }}
        {{ form.code_postal.as_hidden }}
        {{ form.ville.as_hidden }}
        {{ form.referent_mds.as_hidden }}

        {% if form.errors or lien_form.errors %}
        <div class="bg-red-50 border-l-4 border-red-500 p-4 rounded-md animate-pulse">
            <h3 class="text-sm font-bold text-red-800 flex items-center">
                <i class="fas fa-exclamation-triangle mr-2"></i> Erreurs à corriger :
            </h3>
            <ul class="mt-1 text-sm text-red-700 list-disc list-inside">
                {% for field in form %}{% for error in field.errors %}<li>{{ field.label }} : {{ error }}</li>{% endfor %}{% endfor %}
                {% for field in lien_form %}{% for error in field.errors %}<li>{{ field.label }} : {{ error }}</li>{% endfor %}{% endfor %}
            </ul>
        </div>
        {% endif %}

        <section class="space-y-4">
            <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2 flex items-center">
                <span class="bg-blue-600 text-white h-6 w-6 rounded-full inline-flex items-center justify-center text-xs mr-2 shadow">1</span>
                Identité de la personne
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Civilité *</label>
                    {{ form.civilite }}
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Nom *</label>
                    {{ form.nom }}
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Prénom *</label>
                    {{ form.prenom }}
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Date de naissance *</label>
                    {{ form.date_naissance }}
                    <p class="text-[10px] text-gray-400 mt-1 uppercase tracking-wider">Format: DDMMYY ou DD/MM/YYYY</p>
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Lieu de naissance</label>
                    {{ form.lieu_naissance }}
                </div>
            </div>
        </section>

        <section class="bg-gray-50 -mx-8 px-8 py-6 border-y border-gray-100 shadow-inner">
            <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center">
                <span class="bg-orange-500 text-white h-6 w-6 rounded-full inline-flex items-center justify-center text-xs mr-2 shadow">2</span>
                Lien avec {{ beneficiaire_principal.prenom }}
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Type de lien familial *</label>
                    {{ lien_form.type_lien }}
                </div>
                <div>
                    <label class="block text-sm font-semibold text-gray-700 mb-1">Commentaire libre</label>
                    {{ lien_form.commentaire }}
                </div>
            </div>
            
            <div class="flex flex-wrap gap-6 mt-6">
                <label for="{{ lien_form.vit_au_foyer.id_for_label }}" 
                       class="flex items-center space-x-3 bg-white p-3 rounded-lg border border-gray-200 shadow-sm cursor-pointer hover:border-blue-300 transition-colors">
                    {{ lien_form.vit_au_foyer }}
                    <span class="text-sm font-bold text-gray-700 uppercase tracking-tight">Vit au foyer</span>
                </label>

                <label for="{{ lien_form.est_responsable_legal.id_for_label }}" 
                       class="flex items-center space-x-3 bg-white p-3 rounded-lg border border-gray-200 shadow-sm cursor-pointer hover:border-blue-300 transition-colors">
                    {{ lien_form.est_responsable_legal }}
                    <span class="text-sm font-bold text-gray-700 uppercase tracking-tight">Responsable Légal</span>
                </label>
            </div>
        </section>

        <section class="grid grid-cols-1 md:grid-cols-2 gap-8 pt-2">
            <div>
                <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2 flex items-center">
                    <span class="bg-gray-400 text-white h-6 w-6 rounded-full inline-flex items-center justify-center text-xs mr-2">3</span>
                    Identifiants
                </h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">NIR (Sécurité Sociale)</label>
                        {{ form.nir }}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Numéro CAF</label>
                        {{ form.numero_caf }}
                    </div>
                </div>
            </div>

            <div id="contact-section">
                <h2 class="text-lg font-bold text-gray-800 mb-4 border-b pb-2 flex items-center">
                    <span class="bg-gray-400 text-white h-6 w-6 rounded-full inline-flex items-center justify-center text-xs mr-2">4</span>
                    Contact spécifique
                </h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Téléphone mobile</label>
                        {{ form.telephone_mobile }}
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Email</label>
                        {{ form.email }}
                    </div>
                </div>
                <p id="contact-info-msg" class="hidden text-xs text-blue-600 mt-4 italic">
                    <i class="fas fa-home mr-1"></i> Coordonnées héritées du foyer.
                </p>
            </div>
        </section>

        <div class="flex justify-end gap-4 pt-8 border-t">
            <a href="{% url 'beneficiaire:detail_beneficiaire' code_interne=beneficiaire_principal.code_interne %}" 
               class="px-6 py-2 border border-gray-300 rounded-lg text-gray-600 hover:bg-gray-50 transition font-medium">
                Annuler
            </a>
            <button type="submit" class="px-8 py-2 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 shadow-lg shadow-blue-100 transition transform hover:-translate-y-0.5">
                <i class="fas fa-save mr-2"></i> Enregistrer le membre
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const vitAuFoyerCheck = document.getElementById('{{ lien_form.vit_au_foyer.id_for_label }}');
        const contactInputs = document.querySelectorAll('#contact-section input');
        const contactMsg = document.getElementById('contact-info-msg');

        function toggleContactFields() {
            if (vitAuFoyerCheck.checked) {
                contactInputs.forEach(i => i.parentElement.classList.add('opacity-50', 'pointer-events-none'));
                contactMsg.classList.remove('hidden');
            } else {
                contactInputs.forEach(i => i.parentElement.classList.remove('opacity-50', 'pointer-events-none'));
                contactMsg.classList.add('hidden');
            }
        }

        vitAuFoyerCheck.addEventListener('change', toggleContactFields);
        toggleContactFields(); // Etat initial
    });
</script>
{% endblock %}
